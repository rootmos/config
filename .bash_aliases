# shorthand(s)
alias u="ls"
alias e="edit"
alias g="git"

alias c="continuously --"
alias ckgo="c k go"

alias dv='keymap code'
alias se='keymap se'
alias sv='keymap se'
alias us='keymap us'

alias pkg='pkg-add'
alias fetch="fetch walk --"

# preferences
alias cal="/usr/bin/cal -m"
alias ls='ls --color=auto'
alias yay="/usr/bin/yay --sudoflags=-A"
alias pgrep='/usr/bin/pgrep -a'

# missepllings
alias ga="g a"
alias gap="g ap"
alias gc="g c"
alias gca="g ca"
alias gcp="g cp"
alias gcpp="g cpp"
alias gd="g d"
alias gdd="g dd"
alias gp="g p"
alias gpb="g pb"
alias gpp="g pp"
alias gr="g r"
alias gs="g s"
alias gss="g ss"

alias activate="eval \$(poetry env activate)"
alias a=activate

